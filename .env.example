# Radio Bloom - Environment Configuration
# Copy this file to .env and fill in your values

# API
API_PORT=9876

# Web
WEB_PORT=80

# Buncaster
PORT=4321
RTMP_PORT=1935
ADMIN_USER=admin
ADMIN_PASSWORD=changeme
AUDIO_PROCESSING=true
STREAM_BITRATE_KBPS=320
FALLBACK_SOURCE=music/songs

# Publisher
PUBLISHER_PORT=3000

# Spotify (Client Credentials - https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Live (RTMP - OBS)
# RTMP_PORT=1935 (defined above)
# Tiempo mínimo de audio RTMP sostenido (s) antes de pasar a "vivo".
# Filtra conexiones breves/sondas que causarían cortes en el respaldo.
RTMP_MIN_LIVE_SECONDS=5

# FTP
FTP_PUBLIC_HOST=localhost
FTP_PORT=21
FTP_PASSIVE_MIN=30000
FTP_PASSIVE_MAX=30009
FTP_USER_NAME=radio
FTP_USER_PASS=changeme
FTP_USER_HOME=/home/radio
FTP_UMASK=133

# AI DJ & Orchestrator Configuration
AI_DJ_ENABLED=false
OPENROUTER_API_KEY=
AI_DJ_OPENROUTER_MODEL=google/gemini-2.5-flash
AI_DJ_VOICE=es-ES-AlvaroNeural


