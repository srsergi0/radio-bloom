# Radio Bloom - Environment Configuration
# Copy this file to .env and fill in your values

# API
API_PORT=9876

# Web
WEB_PORT=80

# Buncaster (buncaster-cli / BunRadio)
PORT=4321
SRT_PORT=1936
# Legacy RTMP_PORT (compatibilidad, ya no se usa — es SRT 1936/udp)
RTMP_PORT=1935
ADMIN_USER=admin
ADMIN_PASSWORD=changeme
STREAM_BITRATE_KBPS=320
FALLBACK_SOURCE=music/songs
ENABLE_OPUS_TIER=true

# ── Tier del stream (STREAM_TIER=opus|mp3|dual) ──
#   opus -> buncaster sirve opus en /opus (ENABLE_OPUS_TIER=true); el publisher expone solo opus
#   mp3  -> STREAM_FORMAT=mp3 + ENABLE_OPUS_TIER=false
#   dual -> STREAM_FORMAT=mp3 + ENABLE_OPUS_TIER=true
STREAM_TIER=opus
STREAM_FORMAT=mp3
OPUS_TIER_BITRATE_KBPS=192
# Upstream del publisher (buncaster /opus emite cabeceras Ogg/Opus; /mp3 no)
OPUS_UPSTREAM_URL=http://buncaster:4321/opus
MP3_UPSTREAM_URL=
# Retraso del oyente HTTP. Todo lo que se le manda de golpe al conectar se queda en la red y
# retrasa el audio respecto a los metadatos de la web: mantenerlo en pocos segundos.
#   PREBUFFER_SECONDS    -> prebuffer del motor (pisa PREBUFFER_BYTES)
#   STREAM_BURST_SECONDS -> ráfaga que el publisher manda a cada oyente nuevo
PREBUFFER_SECONDS=4
STREAM_BURST_SECONDS=4

# Publisher
PUBLISHER_PORT=3000

# Spotify (Client Credentials - https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Live (SRT - OBS)
# SRT_PORT=1936 (defined above) — OBS: srt://host:1936?streamid=live/STREAM_KEY
RTMP_MIN_LIVE_SECONDS=5
# Legacy RTMP_PORT alias (no usar)

# FTP
FTP_PUBLIC_HOST=localhost
FTP_PORT=21
FTP_PASSIVE_MIN=30000
FTP_PASSIVE_MAX=30009
FTP_USER_NAME=radio
FTP_USER_PASS=changeme
FTP_USER_HOME=/home/radio
FTP_UMASK=133

# AI DJ & Orchestrator Configuration
AI_DJ_ENABLED=false
OPENROUTER_API_KEY=
AI_DJ_OPENROUTER_MODEL=google/gemini-2.5-flash
AI_DJ_VOICE=es-ES-AlvaroNeural



# Studio (panel de control) — protege la API de control (skip, cola, biblioteca, torrents...)
# Generar con: openssl rand -hex 32. Si STUDIO_TOKEN está vacío la API queda ABIERTA (warning al arrancar).
STUDIO_TOKEN=
STUDIO_SESSION_SECRET=
# Pedidos de oyentes: aprobar automáticamente mientras haya < 3 pedidos en cola
REQUESTS_AUTO_APPROVE=false
# Host público para la URL SRT del Studio (default 185.139.1.222)
PUBLIC_HOST=

# Redis interno (solo red docker; nunca publicar el puerto)
REDIS_PASSWORD=

# MoQ (audio de baja latencia por WebTransport; requiere servicio moq-relay y UDP 4433)
MOQ_ENABLED=false
MOQ_RELAY_URL=http://moq-relay:4434
MOQ_PUBLIC_URL=https://<ip-publica>:4433
MOQ_CERT_NAMES=<ip-publica>,localhost
MOQ_FALLBACK_URL=https://radio.tceoslabs.com/radiobloom.opus

# Motor bajo demanda (Buncaster)
MP3_ON_DEMAND=true
SRT_ON_DEMAND=true
