{
  "name": "mcp-lite",
  "version": "0.1.0",
  "description": "Ultra-lightweight MCP server for Bun. Zero Express, zero ajv, zero jose. Full protocol compliance with @modelcontextprotocol/sdk.",
  "type": "module",
  "files": [
    "src/**/*",
    "LICENSE",
    "README.md",
    "FEATURES.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./server": {
      "types": "./src/server/index.d.ts",
      "import": "./src/server/index.js"
    },
    "./server/mcp.js": {
      "types": "./src/server/mcp.d.ts",
      "import": "./src/server/mcp.js"
    },
    "./server/stdio.js": {
      "types": "./src/server/stdio.d.ts",
      "import": "./src/server/stdio.js"
    },
    "./server/webStandardStreamableHttp.js": {
      "types": "./src/server/webStandardStreamableHttp.d.ts",
      "import": "./src/server/webStandardStreamableHttp.js"
    },
    "./validation": {
      "types": "./src/validation/index.d.ts",
      "import": "./src/validation/index.js"
    },
    "./validation/ajv": {
      "types": "./src/validation/types.d.ts",
      "import": "./src/validation/ajv-provider.js"
    },
    "./experimental": {
      "types": "./src/experimental/index.d.ts",
      "import": "./src/experimental/index.js"
    },
    "./experimental/tasks": {
      "types": "./src/experimental/tasks/index.d.ts",
      "import": "./src/experimental/tasks/index.js"
    },
    "./*": {
      "types": "./src/*.d.ts",
      "import": "./src/*.js"
    }
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mcp-lite",
    "mcp-client",
    "ai",
    "llm",
    "claude",
    "anthropic",
    "tools",
    "prompts",
    "resources",
    "hono",
    "bun",
    "lightweight",
    "typescript",
    "streamable-http",
    "stdio",
    "json-rpc",
    "agent",
    "agentic"
  ],
  "license": "MIT",
  "author": "srsergi0",
  "repository": {
    "type": "git",
    "url": "https://github.com/srsergi0/mcp-lite",
    "directory": "packages/mcp-lite"
  },
  "homepage": "https://github.com/srsergi0/mcp-lite",
  "bugs": {
    "url": "https://github.com/srsergi0/mcp-lite/issues"
  },
  "dependencies": {
    "content-type": "^1.0.5",
    "cross-spawn": "^7.0.5",
    "zod-to-json-schema": "^3.25.1"
  },
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": false
    }
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "hono": "^4.12.0",
    "typescript": "^5.7.0"
  }
}