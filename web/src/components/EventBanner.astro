---
import RecentlyPlayedMotion from "./RecentlyPlayedMotion.tsx";
interface Props { isEn?: boolean; }
const { isEn = false } = Astro.props;
---

<section id="events-section" style="padding:24px 32px;">
  <div style="display:flex;align-items:baseline;justify-content:space-between;gap:12px;">
    <h2 style="margin:0;font-family:'Archivo Black',sans-serif;font-size:28px;">{isEn ? "Recently Played" : "Sonó"}</h2>
    <span style="font-family:'Space Mono',monospace;font-size:10px;background:#d9d9d9;border:2px solid #000;padding:3px 8px;">{isEn ? "from library • motion" : "desde biblioteca • motion"}</span>
  </div>
  <p style="margin:8px 0 0 0;font-family:'Space Mono',monospace;font-size:11px;opacity:0.7;">{isEn ? "What has been played — animates only on new entry/exit" : "Qué ha sonado — anima solo al entrar/salir"}</p>

  <RecentlyPlayedMotion client:visible />
</section>
