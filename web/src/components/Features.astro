---
interface Props { isEn?: boolean; }
const { isEn = false } = Astro.props;
const features = [
  { title: isEn ? "Limitless Music" : "Música sin límites", desc: isEn ? "Curated hits 24/7." : "Éxitos curados 24/7." },
  { title: isEn ? "Exclusive Content" : "Contenido exclusivo", desc: isEn ? "Shows & interviews." : "Programas y entrevistas." },
  { title: isEn ? "Wherever You Are" : "Donde quieras", desc: isEn ? "Any device, anywhere." : "Cualquier dispositivo." },
  { title: isEn ? "Bloom Community" : "Comunidad Bloom", desc: isEn ? "Join the sound." : "Únete al sonido." }
];
---

<section style="border-top:2px solid #000;padding:16px 32px;display:grid;grid-template-columns:repeat(4,1fr);gap:12px;background:#fff;">
  {features.map(f => (
    <div style="border:2px solid #000;padding:10px;background:#d9d9d9;box-shadow:4px 4px 0 #000;">
      <div style="font-family:'Archivo Black',sans-serif;font-size:11px;">{f.title}</div>
      <div style="font-size:10px;margin-top:4px;opacity:0.7;">{f.desc}</div>
    </div>
  ))}
</section>
