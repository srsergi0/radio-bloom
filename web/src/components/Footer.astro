---
import Logo from "./Logo.astro";
import type { Lang } from "../lib/i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === "es";
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="ftr__big" aria-hidden="true">
    <Logo size={64} />
    <span>radio<em>tceos</em></span>
  </div>
  <div class="ftr__row">
    <p>{es ? "Hecha en Lima, para escucharse en cualquier parte." : "Made in Lima, for anywhere."}</p>
    <nav aria-label={es ? "Pie de página" : "Footer"}>
      <a href="#ahora">{es ? "Escuchar" : "Listen"}</a>
      <a href="#programacion">{es ? "Programación" : "Schedule"}</a>
      <a href="#escuchala">{es ? "Apps y enlaces" : "Apps & links"}</a>
      <a href={es ? "/en/" : "/"}>{es ? "English" : "Español"}</a>
    </nav>
    <p class="ftr__legal">© {year} Radio Tceos</p>
  </div>
</footer>
