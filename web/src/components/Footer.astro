---
interface Props { isEn?: boolean; }
const { isEn = true } = Astro.props;
---

<footer id="footer" style="border-top:2px solid #000;background:#d9d9d9;padding:16px 32px;">
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:center;">
    <div>
      <div style="font-family:'Space Mono',monospace;font-size:10px;font-weight:700;">[ NEWSLETTER ]</div>
      <div style="font-family:'Archivo Black',sans-serif;font-size:16px;">{isEn ? "Join the movement" : "Únete al movimiento"}</div>
    </div>
    <form onsubmit="event.preventDefault(); alert('Subscribed!')" style="display:flex;gap:8px;">
      <input type="email" placeholder="you@bloom.radio" required style="flex:1;padding:8px 10px;border:2px solid #000;font-family:'Space Mono',monospace;font-size:11px;" />
      <button type="submit" style="background:#000;color:#fff;border:2px solid #000;padding:8px 12px;font-family:'Space Mono',monospace;font-size:11px;font-weight:700;cursor:pointer;box-shadow:3px 3px 0 #000;">{isEn ? "PRE-REGISTER →" : "SUSCRIBIRSE →"}</button>
    </form>
  </div>

  <div style="margin-top:16px;display:grid;grid-template-columns:repeat(2,1fr);gap:12px;font-family:'Space Mono',monospace;font-size:10px;border-top:2px solid #000;padding-top:12px;">
    <div><b>bloom radio®</b></div>
    <div><b>EXPLORE</b><br/><a href="#programs-section" style="color:#000;">Schedule</a><br/><a href="#events-section" style="color:#000;">Events</a><br/><a href="#live-section" style="color:#000;">Listen Live</a></div>
  </div>

  <div style="margin-top:12px;text-align:center;font-family:'Space Mono',monospace;font-size:9px;opacity:0.6;">
    &copy; {new Date().getFullYear()} Bloom Radio. All rights reserved. — 800×600 — Best viewed with Netscape Navigator
  </div>
</footer>
