---
interface Props { isEn?: boolean; }
const { isEn = true } = Astro.props;
const currentPath = Astro.url.pathname;
const homePrefix = currentPath.startsWith("/es") ? "/es" : "";
const isHome = currentPath === "/" || currentPath === "/es" || currentPath === "/es/";
const liveLink = isHome ? "#live-section" : `${homePrefix || "/"}/#live-section`;
const scheduleLink = isHome ? "#programs-section" : `${homePrefix || "/"}/#programs-section`;
const eventsLink = isHome ? "#events-section" : `${homePrefix || "/"}/#events-section`;
---

<!-- Top bar gris como Mac: [icon] Projects Blog Learn Clone me Find me -->
<div style="background:#d9d9d9;border-bottom:2px solid #000;display:flex;align-items:center;gap:16px;padding:6px 12px;font-family:'Space Mono',monospace;font-size:11px;font-weight:700;">
  <a href={isEn ? "/" : "/es"} style="text-decoration:none;color:#000;display:flex;align-items:center;gap:6px;">
    <span style="width:20px;height:20px;border:2px solid #000;background:#fff;display:flex;align-items:center;justify-content:center;font-size:10px;">◉</span>
    bloom radio®
  </a>
  <nav style="display:flex;gap:14px;">
    <a href={liveLink} style="color:#000;text-decoration:none;">Live</a>
    <a href={scheduleLink} style="color:#000;text-decoration:none;">Schedule</a>
    <a href={eventsLink} style="color:#000;text-decoration:none;">Events</a>
  </nav>
  <div style="margin-left:auto;display:flex;gap:6px;align-items:center;">
    <a href="/es" style={`text-decoration:none;padding:2px 6px;border:1.5px solid #000;${!isEn ? 'background:#000;color:#fff;' : 'background:#fff;color:#000;'}`}>ES</a>
    <a href="/" style={`text-decoration:none;padding:2px 6px;border:1.5px solid #000;${isEn ? 'background:#000;color:#fff;' : 'background:#fff;color:#000;'}`}>EN</a>
  </div>
</div>
