---
import Logo from "./Logo.astro";
import { HeaderListen } from "./MiniPlayer";
import type { Lang } from "../lib/i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === "es";
const nav = es
  ? [["#ahora", "Ahora"], ["#programacion", "Programación"], ["#historial", "Historial"], ["#como-funciona", "Cómo funciona"]]
  : [["#ahora", "Now"], ["#programacion", "Schedule"], ["#historial", "History"], ["#como-funciona", "How it works"]];
---

<header class="hdr">
  <a href={es ? "/" : "/en/"} class="hdr__brand" aria-label="Bloom Radio">
    <Logo size={26} />
    <span>bloom<em>radio</em></span>
  </a>
  <nav class="hdr__nav" aria-label={es ? "Secciones" : "Sections"}>
    {nav.map(([href, label]) => <a href={href}>{label}</a>)}
  </nav>
  <div class="hdr__end">
    <a class="hdr__lang" href={es ? "/en/" : "/"} hreflang={es ? "en" : "es"} lang={es ? "en" : "es"}>
      {es ? "EN" : "ES"}
    </a>
    <HeaderListen client:idle lang={lang} />
  </div>
</header>
