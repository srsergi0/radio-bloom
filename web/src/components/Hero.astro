---
interface Props { isEn?: boolean; }
const { isEn = false } = Astro.props;
---

<!-- Hero grid like Mac: left text, right illustration -->
<section style="display:grid;grid-template-columns:1fr 1fr;gap:24px;padding:32px 32px 16px 32px;align-items:center;">
  <div>
    <h1 style="margin:0;font-family:'Archivo Black',sans-serif;font-size:48px;line-height:0.9;letter-spacing:-0.03em;">
      Hello.<br/>I'm Bloom.
    </h1>
    <p style="margin:12px 0 0 0;font-size:12px;line-height:1.5;max-width:360px;">
      {isEn
        ? "I'm a free retro radio made for music lovers. Broadcasting lofi, ambient and organic sounds 24/7."
        : "Soy una radio retro gratis para amantes de la música. Lofi, ambient y sonidos orgánicos 24/7."}
      <br/>
      <span style="text-decoration:underline;">{isEn ? "Made with love in Lima." : "Hecha con amor en Lima."}</span>
    </p>
    <a href="#live-section" style="margin-top:14px;display:inline-block;background:#d9d9d9;border:2px solid #000;padding:8px 12px;font-family:'Space Mono',monospace;font-size:11px;font-weight:700;color:#000;text-decoration:none;box-shadow:3px 3px 0 #000;">
      {isEn ? "Listen on Bloom →" : "Escuchar en Bloom →"}
    </a>
  </div>

  <!-- Solo SVG en grises -->
  <div style="display:flex;justify-content:center;align-items:center;">
    <img src="/robot_logo.svg" alt="Bloom Robot" style="width:100%;max-width:340px;height:auto;filter:grayscale(1) contrast(1.05);display:block;" loading="lazy" />
  </div>
</section>

<!-- Quick links bar -->
<section style="padding:0 32px;">
  <div style="font-family:'Archivo Black',sans-serif;font-size:14px;margin-bottom:6px;">Quick links</div>
  <div style="display:grid;grid-template-columns:repeat(4,1fr);border:2px solid #000;">
    <a href="#live-section" style="background:#d9d9d9;border-right:2px solid #000;padding:8px 10px;display:flex;justify-content:space-between;align-items:center;text-decoration:none;color:#000;font-family:'Space Mono',monospace;font-size:11px;font-weight:700;">Live <span>↗</span></a>
    <a href="#programs-section" style="background:#d9d9d9;border-right:2px solid #000;padding:8px 10px;display:flex;justify-content:space-between;align-items:center;text-decoration:none;color:#000;font-family:'Space Mono',monospace;font-size:11px;font-weight:700;">Schedule <span>↗</span></a>
    <a href="#events-section" style="background:#d9d9d9;border-right:2px solid #000;padding:8px 10px;display:flex;justify-content:space-between;align-items:center;text-decoration:none;color:#000;font-family:'Space Mono',monospace;font-size:11px;font-weight:700;">About <span>↗</span></a>
    <a href="#footer" style="background:#d9d9d9;padding:8px 10px;display:flex;justify-content:space-between;align-items:center;text-decoration:none;color:#000;font-family:'Space Mono',monospace;font-size:11px;font-weight:700;">Contact <span>↗</span></a>
  </div>
</section>
