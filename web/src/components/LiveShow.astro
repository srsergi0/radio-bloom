---
import Player from './Player.astro';
interface Props { isEn?: boolean; }
const { isEn = false } = Astro.props;
const schedule = [
  { time: "10:00", title: "Morning Bloom", host: "Samantha Lee", active: true },
  { time: "14:00", title: "Top Bloom", host: "Alex Martin", active: false },
  { time: "18:00", title: "Bloom Beats", host: "DJ Vibe", active: false },
  { time: "22:00", title: "Night Bloom", host: "Luna Sky", active: false }
];
---

<section id="live-section" style="padding:16px 32px;">
  <div style="display:grid;grid-template-columns:1.2fr 0.8fr;gap:16px;align-items:start;">
    <div>
      <div style="font-family:'Archivo Black',sans-serif;font-size:13px;margin-bottom:6px;">Now Playing</div>
      <Player isEn={isEn} />
    </div>
    <div class="browser">
      <div class="browser-bar">
        <span class="browser-dots"><span></span><span></span></span>
        <span class="browser-title">schedule.html</span>
        <span style="width:20px;"></span>
      </div>
      <table style="width:100%;border-collapse:collapse;font-family:'Space Mono',monospace;font-size:10px;">
        {schedule.map(s => (
          <tr style={`border-top:2px solid #000;${s.active ? 'background:#d9d9d9;' : 'background:#fff;'}`}>
            <td style="padding:8px;font-weight:700;border-right:1.5px solid #000;">{s.time}</td>
            <td style="padding:8px;"><b>{s.title}</b><br/><span style="opacity:0.6;">{isEn ? "with" : "con"} {s.host}</span></td>
            <td style="padding:8px;text-align:right;">{s.active ? <span style="background:#000;color:#fff;padding:1px 6px;">● LIVE</span> : "○"}</td>
          </tr>
        ))}
      </table>
    </div>
  </div>
</section>
