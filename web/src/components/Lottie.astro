---
/**
 * Lottie — Componente aislado y optimizado
 * - Carga diferida: solo importa lottie-web cuando entra en viewport (IntersectionObserver)
 * - Respeta prefers-reduced-motion
 * - Usa requestIdleCallback / requestAnimationFrame
 * - JSON pequeño (4.4KB) en /animations/bloom-pulse.json
 * - Sin bloqueo del main thread, sin hidratación pesada
 */
interface Props {
  src?: string;
  loop?: boolean;
  autoplay?: boolean;
  speed?: number;
  ariaLabel?: string;
  class?: string;
  style?: string;
}
const {
  src = "/animations/bloom-pulse.json",
  loop = true,
  autoplay = true,
  speed = 1,
  ariaLabel = "Animación Lottie",
  class: className = "",
  style = "",
} = Astro.props;
const id = `lottie-${Math.random().toString(36).slice(2, 8)}`;
---

<div
  id={id}
  data-src={src}
  data-loop={loop ? "1" : "0"}
  data-autoplay={autoplay ? "1" : "0"}
  data-speed={String(speed)}
  class={`lottie-box ${className}`}
  style={`width:200px;height:80px;overflow:hidden;${style}`}
  role="img"
  aria-label={ariaLabel}
>
  <!-- Fallback estático (sin JS) — 3 barras grises -->
  <div class="lottie-fallback" aria-hidden="true" style="display:flex;gap:8px;align-items:end;justify-content:center;height:100%;padding:10px;">
    <span style="width:20px;height:28px;background:#000;border:2px solid #000;border-radius:4px;"></span>
    <span style="width:20px;height:40px;background:#8a8a8a;border:2px solid #000;border-radius:4px;"></span>
    <span style="width:20px;height:32px;background:#555;border:2px solid #000;border-radius:4px;"></span>
  </div>
</div>

<style>
  .lottie-box {
    border: 2px solid #000;
    background: #fff;
    box-shadow: 4px 4px 0 #000;
  }
  @media (prefers-reduced-motion: reduce) {
    .lottie-box { animation: none !important; }
  }
</style>

<script>
  // Script aislado — solo corre en cliente, sin framework
  const initLottie = () => {
    const boxes = document.querySelectorAll('.lottie-box[data-src]');
    if (!boxes.length) return;

    // Respeta reduced-motion: no animar
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      boxes.forEach(el => {
        const fallback = el.querySelector('.lottie-fallback');
        if (fallback) (fallback as HTMLElement).style.display = 'flex';
      });
      return;
    }

    const load = (el: Element) => {
      const src = (el as HTMLElement).dataset.src!;
      const loop = (el as HTMLElement).dataset.loop === '1';
      const autoplay = (el as HTMLElement).dataset.autoplay === '1';
      const speed = parseFloat((el as HTMLElement).dataset.speed || '1');

      // Oculta fallback
      const fallback = el.querySelector('.lottie-fallback') as HTMLElement | null;
      if (fallback) fallback.style.display = 'none';

      // Importa lottie-web solo cuando se necesita (code-split)
      const idle = (cb: () => void) => {
        if ('requestIdleCallback' in window) (window as any).requestIdleCallback(cb, { timeout: 2000 });
        else requestAnimationFrame(() => setTimeout(cb, 100));
      };

      idle(async () => {
        try {
          const lottie = await import('lottie-web');
          const anim = (lottie.default || (lottie as any)).loadAnimation({
            container: el as HTMLElement,
            renderer: 'svg',
            loop,
            autoplay,
            path: src,
            rendererSettings: { preserveAspectRatio: 'xMidYMid meet', progressiveLoad: true }
          });
          anim.setSpeed(speed);
          // Pausa cuando no está visible (ahorra CPU)
          const visObs = new IntersectionObserver((entries) => {
            entries.forEach(e => {
              if (e.isIntersecting) anim.play();
              else anim.pause();
            });
          }, { threshold: 0.1 });
          visObs.observe(el);
        } catch (e) {
          console.warn('[Lottie] fallback to static', e);
          if (fallback) fallback.style.display = 'flex';
        }
      });
    };

    const io = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          load(entry.target);
          obs.unobserve(entry.target);
        }
      });
    }, { rootMargin: '200px', threshold: 0.1 });

    boxes.forEach(b => io.observe(b));
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initLottie);
  else initLottie();
</script>
