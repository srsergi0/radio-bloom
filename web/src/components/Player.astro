---
interface Props { isEn?: boolean; }
const { isEn = true } = Astro.props;
---

<div id="live-player-card" class="browser" style="max-width:100%;">
  <div class="browser-bar">
    <span class="browser-dots"><span></span><span></span></span>
    <span class="browser-title">bloom://live — ON AIR</span>
    <span style="width:20px;"></span>
  </div>
  <div style="padding:10px;background:#fff;">
    <div style="background:#000;color:#fff;font-family:'Space Mono',monospace;font-size:11px;padding:6px 8px;border:2px solid #000;white-space:nowrap;overflow:hidden;">
      <span id="track-marquee">{isEn ? "LOADING LIVE SIGNAL..." : "CARGANDO SEÑAL..."}</span>
    </div>
    <div style="margin-top:8px;display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;">
      <button id="play-btn" style="width:56px;height:56px;background:#d9d9d9;border:2px solid #000;box-shadow:3px 3px 0 #000;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:18px;">
        <span id="play-icon">▶</span><span id="pause-icon" style="display:none;">❚❚</span>
      </button>
      <div>
        <div id="track-title-text" style="font-family:'Archivo Black',sans-serif;font-size:14px;">Morning Bloom</div>
        <div id="track-artist-text" style="font-family:'Space Mono',monospace;font-size:10px;opacity:0.7;">con Samantha Lee</div>
        <div style="margin-top:4px;height:6px;background:#d9d9d9;border:1.5px solid #000;display:flex;">
          <div style="flex:1;background:#000;width:68%;"></div>
        </div>
      </div>
      <div style="text-align:center;">
        <input id="volume-slider" type="range" min="0" max="1" step="0.05" value="0.8" style="width:80px;" />
        <button id="volume-btn" style="display:block;margin:4px auto 0 auto;font-family:'Space Mono',monospace;font-size:9px;border:1.5px solid #000;background:#d9d9d9;padding:2px 6px;cursor:pointer;">MUTE</button>
      </div>
    </div>
    <!-- Visualizer funcional: 16 barras driven by Web Audio Analyser -->
    <div id="led-matrix" style="margin-top:8px;display:flex;gap:2px;align-items:end;height:18px;">
      {Array.from({length:16}).map(() => (
        <div class="eq-bar" style="flex:1;height:4px;background:#000;border:1px solid #000;transition:height 0.08s linear;"></div>
      ))}
    </div>
  </div>
</div>

<script>
  const API_BASE = '';
  // Path agnóstico del tier activo (el publisher resuelve opus o mp3)
  const STREAM_URL = '/radiobloom';
  const audio = new Audio();
  audio.preload = "none";
  audio.crossOrigin = "anonymous";

  const playBtn = document.getElementById("play-btn");
  const playIcon = document.getElementById("play-icon");
  const pauseIcon = document.getElementById("pause-icon");
  const card = document.getElementById("live-player-card");
  const marquee = document.getElementById("track-marquee");
  const volSlider = document.getElementById("volume-slider") as HTMLInputElement;
  const volBtn = document.getElementById("volume-btn");
  const tTitle = document.getElementById("track-title-text");
  const tArtist = document.getElementById("track-artist-text");
  const bars = Array.from(document.querySelectorAll('.eq-bar')) as HTMLElement[];

  let isPlaying = false, isMuted = false, prev = 0.8;
  let audioCtx: AudioContext | null = null;
  let analyser: AnalyserNode | null = null;
  let source: MediaElementAudioSourceNode | null = null;
  let dataArray: Uint8Array | null = null;
  let rafId: number | null = null;

  if (volSlider) audio.volume = parseFloat(volSlider.value);

  function ensureAudioGraph(): boolean {
    try {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
        analyser = audioCtx.createAnalyser();
        analyser.fftSize = 64;
        analyser.smoothingTimeConstant = 0.8;
        dataArray = new Uint8Array(analyser.frequencyBinCount);
        source = audioCtx.createMediaElementSource(audio);
        source.connect(analyser);
        analyser.connect(audioCtx.destination);
      }
      if (audioCtx.state === 'suspended') audioCtx.resume();
      return true;
    } catch (err) {
      console.warn("[Player] Web Audio no disponible:", err);
      return false;
    }
  }

  function startVisualizer() {
    if (!analyser || !dataArray) return;
    const tick = () => {
      if (!isPlaying || !analyser || !dataArray) return;
      analyser.getByteFrequencyData(dataArray);
      // 16 barras ← 32 bins (promedia de 2 en 2 para suavizar)
      for (let i = 0; i < bars.length; i++) {
        const v = (dataArray[i*2] + dataArray[i*2+1]) / 2; // 0-255
        const h = 4 + (v / 255) * 14; // 4-18px
        bars[i].style.height = h.toFixed(1) + "px";
        // Brillo según energía: gris → negro
        const intensity = Math.round((v / 255) * 40);
        bars[i].style.background = `rgb(${intensity},${intensity},${intensity})`;
      }
      rafId = requestAnimationFrame(tick);
    };
    tick();
  }

  function stopVisualizer() {
    if (rafId) cancelAnimationFrame(rafId);
    rafId = null;
    bars.forEach(b => { b.style.height = "4px"; b.style.background = "#000"; });
  }

  function toggle() {
    if (isPlaying) {
      audio.pause();
      audio.src = "";
      isPlaying = false;
      if (playIcon) playIcon.style.display = "";
      if (pauseIcon) pauseIcon.style.display = "none";
      card?.classList.remove("playing");
      stopVisualizer();
    } else {
      const ok = ensureAudioGraph();
      audio.src = STREAM_URL;
      audio.load();
      audio.play().then(() => {
        isPlaying = true;
        if (playIcon) playIcon.style.display = "none";
        if (pauseIcon) pauseIcon.style.display = "";
        card?.classList.add("playing");
        if (ok) startVisualizer();
      }).catch(err => {
        console.error("[Player] play failed:", err);
      });
    }
  }

  playBtn?.addEventListener("click", toggle);
  volSlider?.addEventListener("input", e => {
    const v = parseFloat((e.target as HTMLInputElement).value);
    audio.volume = v;
    isMuted = v === 0;
    if (volBtn) volBtn.textContent = isMuted ? "UNMUTE" : "MUTE";
  });
  volBtn?.addEventListener("click", () => {
    if (isMuted) { audio.volume = prev; if (volSlider) volSlider.value = String(prev); isMuted = false; }
    else { prev = audio.volume; audio.volume = 0; if (volSlider) volSlider.value = "0"; isMuted = true; }
    if (volBtn) volBtn.textContent = isMuted ? "UNMUTE" : "MUTE";
  });

  async function fetchMeta() {
    try {
      const r = await fetch(`${API_BASE}/api/stream`);
      if (r.ok) {
        const j = await r.json();
        if (j.ok && j.data) {
          const title = j.data.title || "Morning Bloom";
          const artist = j.data.artist || "Samantha Lee";
          const lang = document.documentElement.lang;
          const codec = j.stream?.codec ? String(j.stream.codec).toUpperCase() : "LIVE";
          const bitrate = j.stream?.bitrate ? `${j.stream.bitrate}K` : "";
          const msg = `${title.toUpperCase()} — ${artist.toUpperCase()} — ${codec}${bitrate}`;
          if (marquee && marquee.textContent !== msg) marquee.textContent = msg;
          if (tTitle && tTitle.textContent !== title) tTitle.textContent = title;
          const pref = lang === 'en' ? 'with' : 'con';
          const full = `${pref} ${artist}`;
          if (tArtist && tArtist.textContent !== full) tArtist.textContent = full;
        }
      }
    } catch (e) { console.warn(e); }
  }
  fetchMeta();
  setInterval(fetchMeta, 10000);

  // Limpieza al salir
  window.addEventListener('beforeunload', () => { if (rafId) cancelAnimationFrame(rafId); try { audioCtx?.close(); } catch {} });
</script>
