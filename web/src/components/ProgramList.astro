---
import UpNextMotion from "./UpNextMotion.tsx";
interface Props { isEn?: boolean; }
const { isEn = false } = Astro.props;
---

<!-- Up Next — queue real con Motion (solo anima entradas/salidas, no en carga inicial) -->
<section id="programs-section" style="background:#d6d6d6;background-image:radial-gradient(#000 0.7px, transparent 0.7px);background-size:4px 4px;border-top:2px solid #000;border-bottom:2px solid #000;padding:24px 32px;">
  <div style="display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:16px;">
    <h2 style="margin:0;font-family:'Archivo Black',sans-serif;font-size:28px;">{isEn ? "Up Next" : "Siguiente"}</h2>
    <span style="font-family:'Space Mono',monospace;font-size:10px;background:#000;color:#fff;padding:3px 8px;border:2px solid #000;">{isEn ? "from queue • motion" : "desde la cola • motion"}</span>
  </div>
  <p style="margin:0 0 16px 0;font-family:'Space Mono',monospace;font-size:11px;opacity:0.7;">{isEn ? "What’s coming — animates only when a new song enters/leaves" : "Qué vendrá — anima solo cuando entra/sale una canción"}</p>

  <UpNextMotion client:visible />
</section>
